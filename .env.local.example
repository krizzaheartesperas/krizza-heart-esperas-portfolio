# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Existing contact form integration (client-side; Web3Forms keys are designed to be public)
VITE_WEB3FORMS_KEY=your_web3forms_access_key

# AI Portfolio Assistant — server-side only, read by api/chat.ts.
# Get a key from https://console.groq.com/keys
# Do NOT prefix with VITE_ — that would expose it to the browser bundle.
GROQ_API_KEY=gsk_your_groq_api_key
# Optional. Defaults to openai/gpt-oss-20b if unset.
GROQ_MODEL=openai/gpt-oss-20b
